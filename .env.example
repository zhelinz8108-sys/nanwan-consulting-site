NEXT_PUBLIC_SITE_URL=https://www.nanwan-consulting.com

# Configure at least one inquiry delivery channel below.

# SMTP configuration for inquiry email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=info@nanwanzx.com
SMTP_PASS=your-smtp-password
NOTIFY_EMAIL=info@nanwanzx.com

# Optional: self-hosted durable file fallback. Prefer a path outside the repo.
# INQUIRY_FILE_PATH=/var/lib/nanwan-consulting/inquiries.jsonl

# Optional: basic anti-spam tuning
# INQUIRY_RATE_LIMIT_MAX=5
# INQUIRY_RATE_LIMIT_WINDOW_MS=600000
